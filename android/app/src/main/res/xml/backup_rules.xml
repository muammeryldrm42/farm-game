<?xml version="1.0" encoding="utf-8"?>
<!-- The same for Android 11 and earlier (see data_extraction_rules.xml). -->
<full-backup-content>
    <!-- the browser keeps these for speed and can make them again: the painted textures of the
         farm (about 22 MB, which would put the app over the 25 MB the backup allows, and then
         nothing would be backed up, the farm included), its GPU and service worker caches -->
    <exclude domain="root" path="app_webview/Default/IndexedDB" />
    <exclude domain="root" path="app_webview/IndexedDB" />
    <exclude domain="root" path="app_webview/Default/GPUCache" />
    <exclude domain="root" path="app_webview/GPUCache" />
    <exclude domain="root" path="app_webview/Default/Service Worker" />
    <exclude domain="root" path="app_webview/Service Worker" />
</full-backup-content>
